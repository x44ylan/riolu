# Secrets and service connections only. Application behavior belongs in the
# JSON files under RIOLU_CONFIG_DIR (default: ~/.config/riolu).
TELEGRAM_TOKEN=replace-me
HOOK_TOKEN=
RIOLU_MCP_TOKEN=
RIOLU_AGENT_TOKEN=

# RIOLU_CONFIG_DIR=~/.config/riolu
RIOLU_OPENCODE_URL=http://127.0.0.1:4096
RIOLU_OPENCODE_PASSWORD=
RIOLU_OPENCODE_PASSWORD_FILE=

# Optional loopback listener overrides.
HOOK_HOST=127.0.0.1
HOOK_PORT=8301
RIOLU_AGENT_URL=http://127.0.0.1:8302
RIOLU_AGENT_HOST=127.0.0.1
RIOLU_AGENT_PORT=8302
