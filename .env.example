TELEGRAM_TOKEN=replace-me

# Optional comma-separated Telegram chat IDs. Leave blank to allow any chat.
ALLOWED_CHAT_IDS=

# Optional automated posting. Leave TARGET_CHAT_ID blank to send built-in digests
# to chats that have started the bot.
TARGET_CHAT_ID=
POST_INTERVAL_MINUTES=60
STATE_PATH=.riolu-state.json

# Bot timezone for reminders.
TIMEZONE=Asia/Singapore

# Optional defaults.
DEFAULT_LIMIT=5
MAX_LIMIT=10
HTTP_TIMEOUT_SECONDS=20

# Built-in sources used by automated digests.
DEFAULT_SOURCE_IDS=hello_github,talkback
